# Line endings: LF in the repository and in every working tree, on Windows too.
# Shell scripts (run.sh, generate-types.sh, the Docker entrypoint) break on CRLF,
# and the Dockerfiles copy files straight from the checkout.
* text=auto eol=lf

# Binary assets: no end-of-line conversion, no textual diff. SVG is XML and
# stays text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary

# Windows-only scripts keep CRLF so cmd.exe reads them correctly.
*.bat text eol=crlf
*.cmd text eol=crlf

# Generated files: never hand-edited (playbook 2.1), collapsed in GitHub diffs.
openapi.json linguist-generated=true
frontend/src/types/api.generated.ts linguist-generated=true
frontend/src/styles/tokens.generated.css linguist-generated=true
backend/poetry.lock linguist-generated=true
frontend/package-lock.json linguist-generated=true
