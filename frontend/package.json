{
  "name": "compliance-watch-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compliance Watch (bleqq) web app. Next.js App Router, Tailwind 4 on Green tokens, Radix primitives, TanStack Query.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:tokens": "node scripts/build-tokens.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:messages": "node scripts/messages-check.mjs",
    "check:copy-drift": "node scripts/copy-drift-check.mjs",
    "test:e2e": "playwright test",
    "demo:record": "node scripts/demo-record.mjs",
    "generate:types": "openapi-typescript ../openapi.json -o src/types/api.generated.ts"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/noto-sans-mono": "5.3.0",
    "@fontsource/libre-caslon-display": "5.3.0",
    "@fontsource/libre-caslon-text": "5.3.0",
    "@fontsource/reenie-beanie": "5.3.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@sebgroup/green-tokens": "3.1.9",
    "@tanstack/react-query": "5.107.1",
    "axios": "1.21.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "input-otp": "1.5.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "minimatch@^10": "11.0.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
