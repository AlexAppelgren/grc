{"id": "c-06", "language": "en", "jurisdiction": "SE", "authority": "Finansinspektionen", "source": "prototype:c6", "text": "FI sanctions Garantum over advice on complex products. FI issued remarks and sanctions of 15 MSEK and 1 MSEK for deficient suitability explanations and undocumented switching, under both the securities and the insurance distribution rules.", "expected": {"change_type": "enforcement", "flags": [], "scope": {"regime": ["securities", "insurance"], "account_type": ["kf", "pension", "depa"], "service_type": ["advice", "insurance_distribution"]}, "risk_flags": []}, "injection": false}
