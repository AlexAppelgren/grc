# Compliance Watch environment variables. A template with no real values (playbook 11.2,
# 12). Where each lives in deployment: docs/runbooks/RAILWAY_DEPLOY.md. Dev-only defaults
# end in -dev-only or start django-insecure- and are allowlisted in .gitleaks.toml.

# ---- Environment (playbook 11.1) ------------------------------------------------------
# local | test | ci are the only non-deployed names. Anything else, or any value in
# RAILWAY_ENVIRONMENT_NAME, means deployed and every boot guard is on.
ENVIRONMENT=local
# Set by the host. Its presence alone means "deployed".
# RAILWAY_ENVIRONMENT_NAME=
# Refused when deployed. Never disarms a guard.
DEBUG=true
# Required when deployed. The default is accepted only on local/test/ci.
SECRET_KEY=django-insecure-dev-only-change-me
# Deterministic emailed codes for E2E. Refused when deployed.
E2E_MODE=false

# ---- Database: two roles (playbook 14) ------------------------------------------------
# The application role: no superuser, no table ownership, no BYPASSRLS. The boot guard
# refuses anything else.
DATABASE_URL=postgres://cw_app:cw-app-dev-only@localhost:5432/compliance_watch
# The migrator role: owns the tables, runs migrations (entrypoint, migrate_from_zero, the
# test runner). Has CREATEDB locally and in CI only.
MIGRATOR_DATABASE_URL=postgres://cw_migrator:cw-migrator-dev-only@localhost:5432/compliance_watch
# Persistent connections (seconds).
DATABASE_CONN_MAX_AGE_S=60
# Superuser URL used by one test to prove the role guard refuses a superuser. Never set in
# a deployed environment.
# TEST_SUPERUSER_DATABASE_URL=postgres://postgres:postgres-dev-only@localhost:5432/compliance_watch

# ---- Redis: cache and Celery broker ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- HTTP -----------------------------------------------------------------------------
ALLOWED_HOSTS=localhost,127.0.0.1
# CORS allowlist, scoped to /api/ (playbook 11.2). Comma-separated origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# HSTS max-age when not DEBUG (seconds).
# SECURE_HSTS_SECONDS=31536000
# Warn above this server time per request (playbook 10).
API_BUDGET_MS=250
SEARCH_BUDGET_MS=800
SEARCH_RERANKED_BUDGET_MS=1500
# "Show what changed" compares sentence by sentence up to this many sentences per version;
# above it, the whole old text is deleted and the new one inserted (keeps the diff in budget).
# Outside 1 to 200 the app refuses to boot.
LIBRARY_DIFF_MAX_SENTENCES=50
# A text longer than this is never split into sentences at all: the whole old text is
# deleted and the whole new one inserted. Texts come from fetched sources, and splitting
# costs about 57 ms per 200 KB.
LIBRARY_TEXT_MAX_CHARS=20000
# ---- The outbox cursor (AUD-01, CAS-01) -----------------------------------------------
# One worker delivers outbox_event in order. Rows per pass, and how often beat runs it
# (also the longest a change waits for its case at an idle moment).
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_S=10
# A handler that raises is tried again after the backoff, doubled per attempt; after the
# last attempt the row is left failed and the cursor moves on.
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BACKOFF_S=60
# ---- One case per bank per change (CAS-01) --------------------------------------------
# A registered change opens a case in every active bank, on the cursor above. This is how
# many bank ids come back per round trip while the fan-out reads the list.
CASE_CREATION_BATCH=100
# ---- When a watched source has gone stale (WAT-01) ------------------------------------
# Stale when the last SOURCE_STALE_AFTER_CHECKS sweeps of a source all failed, or when
# longer than the source's own cadence plus SOURCE_STALE_GRACE_HOURS has passed since the
# last sweep that succeeded. A source whose automated checks are off is never stale.
SOURCE_STALE_AFTER_CHECKS=1
SOURCE_STALE_GRACE_HOURS=24

API_PAGE_SIZE_DEFAULT=20
API_PAGE_SIZE_MAX=100
# The largest offset a list accepts; above it the request is refused instead of asking the
# database to count past its integer range. Below API_PAGE_SIZE_MAX the app refuses to boot.
API_PAGE_OFFSET_MAX=100000
# The most scope terms one library list read filters by (INV-03), and the most a search
# filters by (SRC-02).
LIBRARY_TERM_FILTER_MAX=20
# What a caller may send to search and Ask. Over the cap is a 422, never a truncation.
SEARCH_QUERY_MAX_CHARS=500
SEARCH_SIMILAR_MAX_CHARS=8000
ASK_QUESTION_MAX_CHARS=2000
SEARCH_FEEDBACK_NOTE_MAX_CHARS=2000
# The longest a proposal's source for one changed field may be (PRO-01). A source is an
# https link or the stable key of a provision, and the library's own source_url is 2000.
PROPOSAL_SOURCE_MAX_CHARS=2000
# The most scope terms one obligation proposal may carry; they resolve in one query.
PROPOSAL_SCOPE_MAX_TERMS=20

# ---- Product ---------------------------------------------------------------------------
# The display name; a rebrand is a variable.
PRODUCT_NAME=Compliance Watch

# ---- WebAuthn (DECISIONS D-02) -----------------------------------------------------------
# The exact app host per environment. A passkey belongs to one RP ID.
WEBAUTHN_RP_ID=localhost
# Comma-separated allowed origins.
WEBAUTHN_ORIGINS=http://localhost:3000

# ---- Adapters (playbook 16). A mock is refused on any deployed environment except test.
LLM_PROVIDER=mock                # mock | anthropic | bedrock
# ANTHROPIC_API_KEY=
# E3: the Anthropic provider's thresholds. Only read when LLM_PROVIDER=anthropic.
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=4096              # a ceiling: a caller asking for more gets this
LLM_TIMEOUT_S=60.0               # per socket read (the connect, then each read), not per call
LLM_MAX_RETRIES=2                # 408, 409, 429, 5xx and connection failures, before the answer starts
LLM_RETRY_BACKOFF_S=0.5          # doubled per attempt unless retry-after says otherwise
LLM_DEADLINE_S=180.0             # the whole call, retries and their waits included
LLM_MAX_RESPONSE_BYTES=4194304   # a streamed answer larger than this is refused
LLM_MAX_ERROR_BODY_BYTES=65536   # an error body is read only this far, for its error type
EMBEDDER_PROVIDER=mock           # mock | none (keyword-only search until D-09) | <model>
# EMBEDDER_API_KEY=
EMBEDDING_DIMENSIONS=1024
SEARCH_EMBED_BATCH_SIZE=64        # chunks per embedding call, and the most one outbox delivery embeds (SRC-01)
SEARCH_EMBED_SWEEP_INTERVAL_S=60  # how often the sweep drains whatever embeddings the index still owes
RERANKER_PROVIDER=mock           # mock | none (the fused order stands) | <model>
RERANKER_TOP_K=50                # the fused window the reranker is given (SRC-01)
AGENT_RUNNER=mock                # mock | managed_agents
MAIL_PROVIDER=mock               # mock | smtp
MAIL_FROM=no-reply@localhost
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=

# ---- File storage (playbook 4.6). local is refused when deployed. -----------------------
STORAGE_BACKEND=local            # local | s3
# STORAGE_LOCAL_ROOT=backend/var/media
# STORAGE_S3_ENDPOINT_URL=
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=eu-west-1
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# ---- Identity windows (ID-02, ID-03, ID-06, ID-08; playbook 4.2, DECISIONS D-06) --------
INVITATION_TTL_HOURS=72
ENROLMENT_CODE_DIGITS=6
ENROLMENT_CODE_TTL_MINUTES=10
ENROLMENT_CODE_MAX_ATTEMPTS=5
ENROLMENT_CODE_RATE_PER_ADDRESS_PER_HOUR=5
ENROLMENT_CODE_RATE_PER_IP_PER_HOUR=20
SESSION_IDLE_MINUTES_DEFAULT=30
SESSION_ABSOLUTE_HOURS_DEFAULT=12
SESSION_IDLE_MINUTES_MAX=480
SESSION_ABSOLUTE_HOURS_MAX=24
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_REPLAY_GRACE_SECONDS=30
STEP_UP_FRESHNESS_MINUTES=5
# Off in tests, on everywhere else.
RATE_LIMITING_ENABLED=true

# ---- Health (playbook 2.2) --------------------------------------------------------------
HEALTH_WORKER_PING_TIMEOUT_S=1.0

# ---- Observability (playbook 4.7, 11.2) -------------------------------------------------
LOG_LEVEL=INFO
# Sentry on its EU region; unset means off. No PII, no bodies, no local variables.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Gunicorn (docker-entrypoint.sh) -----------------------------------------------------
# PORT=8000
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT_S=60

# ---- Frontend --------------------------------------------------------------------------
# The API's public URL as the browser sees it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Added with chunk 1 (identity) ---------------------------------------------------
# Public base URL of the web app; invitation links are built on it.
APP_BASE_URL=http://localhost:3000
# WebAuthn ceremony challenges expire after this many seconds (playbook 4.2).
CHALLENGE_TTL_SECONDS=120
# Requests per IP per minute on the auth endpoints (rate limiting, off in tests).
AUTH_RATE_PER_IP_PER_MINUTE=30
# Proxies of ours that append to X-Forwarded-For. 0 ignores the header (the socket
# address is the client); 1 behind Railway's edge. Never more than the hops you own.
TRUSTED_PROXY_HOPS=0
# An API key's last_used_at is written at most once per this many seconds.
API_KEY_LAST_USED_THROTTLE_SECONDS=60
